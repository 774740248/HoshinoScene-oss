<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="#66000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@id/view_main"
        android:padding="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/quickly_grant_dialog"
            android:paddingBottom="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:minHeight="150.0dip"
            android:alpha="0.9">
            <TextView
                android:textSize="26.0dip"
                android:id="@id/confirm_title"
                android:text="@string/appops_quickly_grant"
                android:fontFamily="sans-serif-condensed-light"
                android:breakStrategy="simple"
                style="@style/dialogTitle" />
            <TextView
                android:id="@id/confirm_message"
                android:text="[****]正在請求[****]許可權，是否立即允許？"
                android:breakStrategy="simple"
                style="@style/dialogDesc" />
            <TextView
                android:text="@string/appops_quickly_grant_desc"
                android:breakStrategy="simple"
                style="@style/dialogDesc" />
            <FrameLayout
                android:id="@id/confirm_custom_view"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip">
            <Button
                android:id="@id/btn_cancel"
                android:text="@string/btn_cancel"
                android:layout_marginEnd="8.0dip"
                style="@style/dialogCancelBtn" />
            <Button
                android:id="@id/btn_confirm"
                android:text="@string/btn_confirm"
                style="@style/dialogConfirmBtn" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>