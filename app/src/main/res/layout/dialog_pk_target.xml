<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/confirm_dialog_bg"
            android:paddingBottom="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:minHeight="150.0dip"
            android:alpha="0.8">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@id/confirm_title"
                    android:layout_width="0.0dip"
                    android:text="@string/fps_pk_current"
                    android:layout_weight="1.0"
                    android:textAlignment="viewStart"
                    android:breakStrategy="simple"
                    style="@style/dialogTitle" />
                <TextView
                    android:id="@id/id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/textSmall" />
                <ImageView
                    android:id="@id/copy"
                    android:padding="8.0dip"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/app_options_copy"
                    android:alpha="0.5"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>
            <TextView
                android:id="@id/confirm_message"
                android:text="@string/fps_pk_input"
                android:breakStrategy="simple"
                style="@style/dialogDesc" />
            <EditText
                android:id="@id/input"
                android:background="@drawable/in_card_item_inactive"
                android:padding="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16.0dip" />
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <View
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <TextView
                    android:textColor="@color/colorAccent"
                    android:id="@id/local_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fps_pk_choose"
                    android:layout_marginStart="@dimen/activity_horizontal_margin"
                    android:layout_marginEnd="@dimen/activity_horizontal_margin"
                    style="@style/textDefault" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip">
            <Button
                android:id="@id/btn_cancel"
                android:text="@string/btn_cancel"
                android:layout_marginEnd="8.0dip"
                style="@style/dialogCancelBtn" />
            <Button
                android:id="@id/btn_confirm"
                android:text="@string/btn_confirm"
                style="@style/dialogConfirmBtn" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>