<?xml version="1.0" encoding="utf-8"?>
<com.omarea.ui.BlurViewRelativeLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/list_view_bg"
    android:padding="@dimen/activity_vertical_margin"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@id/games_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/perf_games"
            android:layout_weight="1.0"
            style="@style/textTitle" />
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@id/remote_play"
            android:background="?android:actionBarItemBackground"
            android:padding="3.0dip"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/ic_scrcpy"
            android:scaleType="centerInside"
            android:tint="?android:colorAccent" />
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@id/fast_share"
            android:background="?android:actionBarItemBackground"
            android:padding="4.0dip"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/icon_fast_share"
            android:scaleType="centerInside"
            android:tint="?android:colorAccent"
            android:layout_marginStart="10.0dip" />
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@id/sort"
            android:background="?android:actionBarItemBackground"
            android:padding="4.0dip"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/icon_sort"
            android:scaleType="centerInside"
            android:tint="?android:colorAccent"
            android:layout_marginStart="10.0dip" />
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@id/sort_confirm"
            android:background="?android:actionBarItemBackground"
            android:padding="3.0dip"
            android:visibility="gone"
            android:layout_width="25.0dip"
            android:layout_height="25.0dip"
            android:src="@drawable/icon_confirm"
            android:scaleType="centerInside"
            android:tint="?android:colorAccent"
            android:layout_marginStart="10.0dip" />
        <CheckBox
            android:id="@id/lock"
            android:background="?android:actionBarItemBackground"
            android:layout_marginStart="12.0dip"
            android:foregroundTint="?android:colorAccent"
            style="@style/SceneEye" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/games"
        android:layout_width="fill_parent"
        android:layout_height="230.0dip"
        android:layout_marginTop="10.0dip"
        android:numColumns="4"
        android:layout_below="@id/games_title"
        android:layout_alignParentBottom="true"
        style="@style/SceneScrollView" />
</com.omarea.ui.BlurViewRelativeLayout>