<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/layout_app_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_app_bar" />
    <ImageView
        android:id="@id/btn_reset"
        android:padding="10.0dip"
        android:layout_marginBottom="9.0dip"
        android:src="@drawable/icon_clear"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:layout_alignParentEnd="true"
        style="@style/SceneTitleBarBtn" />
    <com.omarea.ui.BlurView
        android:background="@drawable/list_view_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="?actionBarSize"
        android:layout_above="@id/search_bar"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <ListView
            android:id="@id/scene_app_list"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@null"
            android:layout_alignParentStart="true"
            android:importantForAutofill="no" />
    </com.omarea.ui.BlurView>
    <com.omarea.ui.BlurViewLinearLayout
        android:id="@id/search_bar"
        android:background="@drawable/filter_toolbar_bg"
        android:layout_width="fill_parent"
        android:layout_height="50.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_alignParentBottom="true"
        android:paddingStart="10.0dip"
        android:paddingEnd="0.0dip"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <EditText
            android:textSize="16.0dip"
            android:id="@id/config_search_box"
            android:background="@android:color/transparent"
            android:padding="8.0dip"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:hint="@string/apps_search_placeholder"
            android:singleLine="true"
            android:layout_weight="1.0"
            android:inputType="textFilter"
            android:imeOptions="actionSearch" />
        <com.omarea.ui.SelectView
            android:layout_gravity="center_vertical"
            android:id="@id/configlist_type"
            android:focusable="false"
            android:layout_width="80.0dip"
            android:layout_height="wrap_content" />
        <com.omarea.ui.SelectView
            android:layout_gravity="center_vertical"
            android:id="@id/configlist_modes"
            android:focusable="false"
            android:layout_width="110.0dip"
            android:layout_height="wrap_content" />
    </com.omarea.ui.BlurViewLinearLayout>
</RelativeLayout>