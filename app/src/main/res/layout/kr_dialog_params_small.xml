<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:focusable="true"
    android:clickable="true"
    style="@style/dialogRoot"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/krscript_item_ripple_inactive"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <TextView
            android:id="@id/title"
            style="@style/dialogTitle" />
        <TextView
            android:id="@id/desc"
            style="@style/dialogDesc" />
        <TextView
            android:id="@id/warn"
            style="@style/dialogWarn" />
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@id/kr_params_center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip">
        <Button
            android:id="@id/btn_cancel"
            android:text="@string/btn_cancel"
            style="@style/dialogCancelBtn" />
        <Button
            android:id="@id/btn_confirm"
            android:text="@string/btn_confirm"
            style="@style/dialogConfirmBtn" />
    </LinearLayout>
</LinearLayout>