<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:saveEnabled="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/layout_app_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_app_bar" />
    <LinearLayout
        android:gravity="end|center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/layout_app_bar"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@id/orms_btn_more"
            android:padding="9.0dip"
            android:src="@drawable/icon_more"
            android:layout_marginEnd="8.0dip"
            style="@style/SceneTitleBarBtn" />
    </LinearLayout>
    <com.omarea.ui.BlurView
        android:background="@drawable/list_view_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@id/layout_app_bar">
        <com.omarea.ui.CornerScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fastScrollEnabled="true"
            android:fastScrollAlwaysVisible="true">
            <EditText
                android:textSize="12.0dip"
                android:typeface="monospace"
                android:gravity="top"
                android:id="@id/thermal_config"
                android:background="@null"
                android:padding="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="please wait……"
                android:breakStrategy="simple"
                android:autofillHints="" />
        </com.omarea.ui.CornerScrollView>
    </com.omarea.ui.BlurView>
</RelativeLayout>