<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.omarea.common.ui.OverScrollView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@id/nav_scene_service_not_active"
                layout="@layout/layout_accessibility_state" />
            <com.omarea.ui.apps.Games
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12.0dip"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin" />
            <com.omarea.ui.BlurViewLinearLayout
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="8.0dip"
                style="@style/ListCardItem">
                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@id/config_author"
                        android:background="?actionBarItemBackground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:layout_alignParentStart="true"
                        style="@style/textTitle" />
                    <ImageButton
                        android:id="@id/config_author_icon"
                        android:background="?actionBarItemBackground"
                        android:padding="0.0dip"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:src="@drawable/source_switch"
                        android:scaleType="centerInside"
                        android:tint="?android:colorAccent"
                        android:layout_marginStart="4.0dip"
                        android:layout_toEndOf="@id/config_author" />
                    <ImageButton
                        android:id="@id/custom_features"
                        android:padding="0.0dip"
                        android:layout_width="20.0dip"
                        android:layout_height="20.0dip"
                        android:src="@drawable/settings"
                        android:scaleType="centerInside"
                        android:tint="@color/colorAccent"
                        android:layout_marginStart="8.0dip"
                        android:layout_toEndOf="@id/config_author_icon"
                        style="@style/SceneButtonLight" />
                    <Switch
                        android:id="@id/dynamic_control"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>
                <TextView
                    android:id="@id/custom_state"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/textXSmall" />
                <LinearLayout
                    android:gravity="fill_vertical"
                    android:orientation="horizontal"
                    android:id="@id/custom_modes"
                    android:layout_width="fill_parent"
                    android:layout_height="30.0dip"
                    android:layout_marginVertical="8.0dip">
                    <TextView
                        android:id="@id/custom_powersave"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/powersave_short"
                        android:layout_weight="90.0"
                        style="@style/SceneButtonLight" />
                    <TextView
                        android:id="@id/custom_balance"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/balance_short"
                        android:layout_weight="80.0"
                        android:layout_marginStart="4.0dip"
                        style="@style/SceneButtonLight" />
                    <TextView
                        android:id="@id/custom_performance"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/performance_short"
                        android:layout_weight="90.0"
                        android:layout_marginStart="4.0dip"
                        style="@style/SceneButtonLight" />
                    <TextView
                        android:id="@id/custom_fast"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/fast_short"
                        android:layout_weight="80.0"
                        android:layout_marginStart="4.0dip"
                        style="@style/SceneButtonLight" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/dynamic_control_opts"
                    android:background="@drawable/in_card_item_inactive"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@id/first_mode_view"
                        android:paddingLeft="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center_vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_screen_on"
                            android:layout_weight="1.0"
                            style="@style/textTitle" />
                        <com.omarea.ui.SelectView
                            android:layout_gravity="center|right"
                            android:id="@id/first_mode"
                            android:layout_width="110.0dip"
                            android:layout_height="wrap_content"
                            app:popupWidth="120.0dip" />
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@id/pedestal_mode_view"
                        android:padding="10.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_gravity="center_vertical"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_pedestal"
                            android:layout_weight="1.0"
                            style="@style/textTitle" />
                        <Switch
                            android:layout_gravity="center_vertical"
                            android:id="@id/pedestal_mode"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:layout_marginEnd="6.0dip"
                            style="@style/textTitle" />
                    </LinearLayout>
                </LinearLayout>
            </com.omarea.ui.BlurViewLinearLayout>
            <com.omarea.ui.BlurViewLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/extreme_performance"
                android:background="@drawable/krscript_item_ripple"
                android:layout_marginTop="1.0dip"
                android:minHeight="65.0dip"
                android:layout_weight="1.0"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                style="@style/ListCardItemSmall">
                <ImageView
                    android:padding="11.0dip"
                    android:src="@drawable/icon_danger"
                    android:backgroundTint="@color/color_pedestal_light"
                    app:tint="@color/color_pedestal"
                    style="@style/SceneActionIcon" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <Switch
                        android:id="@id/extreme_performance_on"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:text="@string/schedule_excellent" />
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_excellent_desc"
                        style="@style/textSmall" />
                </LinearLayout>
            </com.omarea.ui.BlurViewLinearLayout>
            <com.omarea.ui.BlurViewLinearLayout
                android:orientation="horizontal"
                android:id="@id/nav_app_scene"
                android:background="@drawable/krscript_item_ripple"
                android:minHeight="65.0dip"
                android:layout_weight="1.0"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                style="@style/ListCardItemSmall">
                <ImageView
                    android:padding="10.0dip"
                    android:src="@drawable/ic_menu_profile"
                    android:scaleType="centerInside"
                    android:backgroundTint="@color/color_powersave_light"
                    app:tint="@color/color_powersave"
                    style="@style/SceneActionIcon" />
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:text="@string/schedule_app"
                        style="@style/textTitle" />
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_app_desc"
                        style="@style/textSmall" />
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/arrow"
                    android:scaleType="centerInside"
                    android:alpha="0.8"
                    app:tint="#ff808080" />
            </com.omarea.ui.BlurViewLinearLayout>
            <com.omarea.ui.BlurViewLinearLayout
                android:orientation="horizontal"
                android:id="@id/nav_skip_ad"
                android:background="@drawable/krscript_item_ripple"
                android:minHeight="65.0dip"
                android:layout_weight="1.0"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
                style="@style/ListCardItemSmall">
                <ImageView
                    android:padding="9.0dip"
                    android:src="@drawable/ic_menu_click"
                    android:backgroundTint="@color/color_powersave_light"
                    app:tint="@color/color_powersave"
                    style="@style/SceneActionIcon" />
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4.0dip"
                        android:text="@string/menu_auto_click"
                        style="@style/textTitle" />
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scene_skip_desc"
                        style="@style/textSmall" />
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:background="@null"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/arrow"
                    android:scaleType="centerInside"
                    android:alpha="0.8"
                    app:tint="#ff808080" />
            </com.omarea.ui.BlurViewLinearLayout>
            <com.omarea.ui.BlurViewLinearLayout
                android:orientation="vertical"
                android:id="@id/nav_more"
                android:background="@drawable/in_card_item"
                android:padding="@dimen/activity_horizontal_margin"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
                <TextView
                    android:textColor="?android:textColorSecondary"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/look_other"
                    style="@style/textDefault" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip">
                    <TextView
                        android:textColor="@color/colorAccent"
                        android:id="@id/nav_thermal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/scene_disable_thermal"
                        android:layout_marginEnd="20.0dip"
                        style="@style/textTitle" />
                    <TextView
                        android:textColor="@color/colorAccent"
                        android:id="@id/nav_freeze"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_freeze"
                        android:layout_marginEnd="20.0dip"
                        style="@style/textTitle" />
                </LinearLayout>
            </com.omarea.ui.BlurViewLinearLayout>
        </LinearLayout>
    </com.omarea.common.ui.OverScrollView>
</RelativeLayout>