<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/tab_apps_user"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.omarea.ui.BlurViewRelativeLayout
        android:background="@drawable/list_view_bg"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginBottom="8.0dip"
        android:layout_weight="1.0"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <LinearLayout
            android:gravity="end"
            android:id="@id/select_all"
            android:padding="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:layout_marginHorizontal="12.0dip">
            <CheckBox
                android:id="@id/select_state_all"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="30.0dip" />
        </LinearLayout>
        <ListView
            android:id="@id/app_list"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@null"
            android:layout_below="@id/select_all"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true" />
        <com.omarea.ui.CornerView
            android:id="@id/fab_apps"
            android:background="?cardBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40.0dip"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="55.0dip"
            android:layout_alignParentEnd="true"
            android:elevation="4.0dip"
            android:outlineSpotShadowColor="#ff505050"
            android:outlineAmbientShadowColor="#ff505050"
            app:cornerRadius="25.0dip">
            <ImageView
                android:background="?actionBarItemBackground"
                android:padding="15.0dip"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:src="@drawable/icon_menu"
                android:scaleType="centerInside"
                app:tint="@color/colorAccent" />
        </com.omarea.ui.CornerView>
    </com.omarea.ui.BlurViewRelativeLayout>
</LinearLayout>