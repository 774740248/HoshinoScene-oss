<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.omarea.ui.BlurView
        android:paddingTop="10.0dip"
        style="@style/ListCardItem">
        <GridLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_marginBottom="10.0dip"
                android:layout_row="0"
                android:layout_columnSpan="2">
                <TextView
                    android:id="@id/cluster_title"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    android:layout_weight="1.0"
                    style="@style/textTitle" />
                <ImageView
                    android:id="@id/cluster_time_in_state"
                    android:background="?android:actionBarItemBackground"
                    android:padding="3.0dip"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/app_options_data"
                    android:layout_marginEnd="@dimen/activity_horizontal_margin"
                    app:tint="@android:color/darker_gray" />
                <ImageView
                    android:id="@id/cluster_governor_params"
                    android:background="?android:actionBarItemBackground"
                    android:padding="3.0dip"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/app_options_details"
                    app:tint="?android:colorAccent" />
            </LinearLayout>
            <TextView
                android:textSize="14.0dip"
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:layout_column="0"
                android:text="@string/perf_min_freq"
                android:layout_row="1" />
            <TextView
                android:textSize="14.0dip"
                android:id="@id/cluster_min_freq"
                android:padding="5.0dip"
                android:layout_width="150.0dip"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="Min Freq"
                android:layout_row="1"
                android:textAlignment="textEnd" />
            <TextView
                android:textSize="14.0dip"
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:layout_column="0"
                android:text="@string/perf_max_freq"
                android:layout_row="2" />
            <TextView
                android:textSize="14.0dip"
                android:id="@id/cluster_max_freq"
                android:padding="5.0dip"
                android:layout_width="150.0dip"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:text="Max Freq"
                android:layout_row="2"
                android:textAlignment="textEnd" />
            <TextView
                android:textSize="14.0dip"
                android:gravity="center_vertical"
                android:layout_gravity="fill"
                android:layout_column="0"
                android:text="@string/perf_governor"
                android:layout_row="3" />
            <TextView
                android:textSize="14.0dip"
                android:id="@id/cluster_governor"
                android:padding="5.0dip"
                android:layout_width="150.0dip"
                android:layout_column="1"
                android:text="Governor"
                android:layout_row="3"
                android:textAlignment="textEnd" />
        </GridLayout>
    </com.omarea.ui.BlurView>
</FrameLayout>