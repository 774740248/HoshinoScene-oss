<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.omarea.ui.BlurViewLinearLayout
        android:orientation="horizontal"
        android:id="@id/view_realtime_values"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.0dip"
        style="@style/ListCardItem">
        <FrameLayout
            android:id="@id/battery_capacity_wrap"
            android:padding="0.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.omarea.ui.BatteryView
                android:layout_gravity="center"
                android:id="@id/battery_capacity_chart"
                android:layout_width="130.0dip"
                android:layout_height="130.0dip" />
            <TextView
                android:textSize="28.0dip"
                android:layout_gravity="center"
                android:id="@id/battrystatus_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:alpha="0.7"
                android:fontFamily="sans-serif-condensed-light"
                style="@style/textTitle" />
        </FrameLayout>
        <View
            android:layout_gravity="center_vertical"
            android:background="#20808080"
            android:layout_width="1.0dip"
            android:layout_height="110.0dip"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="130.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="8.0dip">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@id/charge_state"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="21.0dip"
                    android:text="----"
                    android:layout_weight="1.0"
                    style="@style/textDefault" />
                <ImageView
                    android:id="@id/charge_display_light"
                    android:background="?android:actionBarItemBackground"
                    android:padding="4.0dip"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/ic_light" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15.0dip"
                    android:layout_height="15.0dip"
                    android:src="@drawable/ic_battery2"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="2.0dip"
                    app:tint="#ff888888" />
                <TextView
                    android:id="@id/battery_power"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    style="@style/textSmall" />
                <ImageView
                    android:layout_width="15.0dip"
                    android:layout_height="15.0dip"
                    android:src="@drawable/ic_power_supply"
                    android:scaleType="centerInside"
                    android:alpha="0.5"
                    android:layout_marginEnd="2.0dip"
                    app:tint="#ff888888" />
                <TextView
                    android:id="@id/battery_charge_power"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:alpha="0.5"
                    style="@style/textSmall" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:paddingVertical="0.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:src="@drawable/ic_temperature"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="2.0dip"
                        app:tint="#ff888888" />
                    <TextView
                        android:id="@id/battery_temperature"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        style="@style/textSmall" />
                    <ImageView
                        android:layout_width="15.0dip"
                        android:layout_height="15.0dip"
                        android:src="@drawable/ic_capacity"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="2.0dip"
                        app:tint="#ff888888" />
                    <TextView
                        android:id="@id/battery_status"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        style="@style/textSmall" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="15.0dip"
                    android:layout_height="15.0dip"
                    android:src="@drawable/ic_cycle"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="2.0dip"
                    app:tint="#ff888888" />
                <TextView
                    android:textColor="@color/colorAccent"
                    android:id="@id/battery_cycle"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    style="@style/textSmall" />
                <TextView
                    android:id="@id/battery_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
    </com.omarea.ui.BlurViewLinearLayout>
</RelativeLayout>