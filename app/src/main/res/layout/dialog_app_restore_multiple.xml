<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8.0dip"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="8.0dip"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:alpha="0.85">
        <TextView
            android:id="@id/confirm_title"
            android:text="@string/make_choice"
            style="@style/dialogTitle" />
        <TextView
            android:id="@id/confirm_message"
            android:visibility="gone"
            style="@style/dialogDesc" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_install"
            android:background="@drawable/krscript_item_ripple"
            android:layout_height="65.0dip"
            android:layout_weight="1.0"
            style="@style/ListCardItemSmall">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/action_menu_icon_bg"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/app_options_apk"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                android:backgroundTint="@android:color/holo_green_dark"
                app:tint="#ffffffff" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip"
                    android:text="@string/apps_op_restore_app"
                    style="@style/textTitle" />
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_op_restore_app"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_restore_full"
            android:background="@drawable/krscript_item_ripple"
            android:layout_height="65.0dip"
            android:layout_weight="1.0"
            style="@style/ListCardItemSmall">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/action_menu_icon_bg"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/app_options_apk"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                android:backgroundTint="#ffffb300"
                app:tint="#ffffffff" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip"
                    android:text="@string/apps_op_restore_all"
                    style="@style/textTitle" />
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_op_restore_all_desc"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_restore_data"
            android:background="@drawable/krscript_item_ripple"
            android:layout_height="65.0dip"
            android:layout_weight="1.0"
            style="@style/ListCardItemSmall">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/action_menu_icon_bg"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/app_options_apk"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                android:backgroundTint="#ffffb300"
                app:tint="#ffffffff" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip"
                    android:text="@string/apps_op_restore_data"
                    style="@style/textTitle" />
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_op_restore_data_desc"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/app_delete_backup"
            android:background="@drawable/krscript_item_ripple"
            android:layout_height="65.0dip"
            android:layout_weight="1.0"
            style="@style/ListCardItemSmall">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/action_menu_icon_bg"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/app_options_uninstall"
                android:scaleType="centerInside"
                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                android:backgroundTint="#ffff5722"
                app:tint="#ffffffff" />
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4.0dip"
                    android:text="@string/apps_op_delete_backup"
                    style="@style/textTitle" />
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_op_delete_backup_desc"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>