<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/drawer_layout"
    android:fitsSystemWindows="false"
    android:clipToPadding="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:keepScreenOn="false"
    android:backgroundTintMode="screen"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <com.omarea.ui.CornerScrollView
        android:paddingTop="?android:actionBarSize"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                style="@style/ListCardItem">
                <ImageView
                    android:id="@id/app_details_icon"
                    android:layout_width="50.0dip"
                    android:layout_height="50.0dip"
                    android:src="@drawable/linux" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginStart="8.0dip">
                    <TextView
                        android:id="@id/app_details_name"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5.0dip"
                        android:text="@string/app_name"
                        style="@style/textTitle" />
                    <TextView
                        android:id="@id/app_details_packagename"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        style="@style/textSmall" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/ListCardItemLast">
                <TextView
                    android:gravity="center"
                    android:id="@id/app_details_vaddins_notinstall"
                    android:background="@drawable/in_card_item"
                    android:paddingTop="10.0dip"
                    android:paddingBottom="10.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:layout_marginRight="0.0dip"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:minHeight="50.0dip"
                    android:text="@string/xp_addin_lost" />
                <TextView
                    android:gravity="center"
                    android:id="@id/app_details_vaddins_notactive"
                    android:background="@drawable/in_card_item"
                    android:paddingTop="10.0dip"
                    android:paddingBottom="10.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="0.0dip"
                    android:layout_marginTop="0.0dip"
                    android:layout_marginRight="0.0dip"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:text="@string/xp_xposed_disabled" />
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="DPI"
                        android:layout_weight="1.0"
                        style="@style/scene_config_item" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:id="@id/app_details_dpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_default"
                        android:paddingEnd="10.0dip" />
                </LinearLayout>
                <Switch
                    android:id="@id/app_details_excludetask"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_hide_recent"
                    style="@style/scene_config_item" />
                <Switch
                    android:id="@id/app_details_scrollopt"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_slow_scroll"
                    style="@style/scene_config_item" />
                <Switch
                    android:id="@id/app_details_web_debug"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_web_debug"
                    style="@style/scene_config_item" />
                <TextView
                    android:textColor="?android:colorAccent"
                    android:id="@id/addin_auto_run_help"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xp_tip"
                    style="@style/textSmall" />
            </LinearLayout>
        </LinearLayout>
    </com.omarea.ui.CornerScrollView>
    <include
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        layout="@layout/layout_app_bar" />
</FrameLayout>