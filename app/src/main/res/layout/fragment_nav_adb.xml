<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/nav"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/activity_horizontal_margin">
        <GridLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-4.0dip"
            android:layout_marginRight="-4.0dip"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:columnCount="@integer/nav_grid_columns">
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginRight="4.0dip"
                android:text="@string/menu_group_perf"
                android:layout_columnSpan="@integer/nav_grid_columns"
                style="@style/textSmall" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_processes"
                android:tag="adb"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_processes"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_processes"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_fps_chart"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/fw_float_fps"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_fps_chart"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_charge"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_charge"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_charge"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_power_utilization"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_bat_stats"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_power_utilization"
                style="@style/nav_item_wrap" />
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginRight="4.0dip"
                android:text="@string/menu_group_apps"
                android:layout_columnSpan="@integer/nav_grid_columns"
                style="@style/textSmall" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_applictions"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_modules"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_applictions"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_activities"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_activities"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_activities"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_auto_click"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_click"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_auto_click"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_screen_test"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/icon_display"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_screen_test"
                style="@style/nav_item_wrap" />
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4.0dip"
                android:layout_marginTop="12.0dip"
                android:layout_marginRight="4.0dip"
                android:text="@string/menu_group_advance"
                android:layout_columnSpan="@integer/nav_grid_columns"
                style="@style/textSmall" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_dpi_adb"
                android:tag="adb"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/icon_display"
                app:layout_res="@layout/nav_item2"
                app:text="@string/addin_dpi"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_dex2oat_adb"
                android:tag="adb"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_modules"
                app:layout_res="@layout/nav_item2"
                app:text="@string/addin_force_dex_compile"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_app_files"
                android:tag="adb"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/icon_folder"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_files"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_miui_thermal"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_xiaomi"
                app:layout_res="@layout/nav_item2"
                app:text="@string/menu_miui_thermal"
                style="@style/nav_item_wrap" />
        </GridLayout>
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>