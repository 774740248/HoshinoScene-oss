<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/nav"
        android:paddingBottom="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:paddingHorizontal="@dimen/activity_horizontal_margin">
        <GridLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-4.0dip"
            android:layout_marginRight="-4.0dip"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:columnCount="1">
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <Space
                style="@style/nav_grid_spacer" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_fps_chart"
                app:drawable="@drawable/fw_float_fps"
                app:text="@string/menu_fps_chart"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_charge"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_charge"
                app:text="@string/menu_charge"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_power_utilization"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_bat_stats"
                app:text="@string/menu_power_utilization"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_applictions"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_modules"
                app:text="@string/menu_applictions"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_activities"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_activities"
                app:text="@string/menu_activities"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_miui_thermal"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/ic_menu_xiaomi"
                app:text="@string/menu_miui_thermal"
                style="@style/nav_item_wrap" />
            <com.omarea.ui.NavItem
                android:id="@id/nav_screen_test"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                app:drawable="@drawable/icon_display"
                app:text="@string/menu_screen_test"
                style="@style/nav_item_wrap" />
        </GridLayout>
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>