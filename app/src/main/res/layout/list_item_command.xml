<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:background="@drawable/list_item_ripple"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="6.0dip"
    android:paddingVertical="10.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/ItemIcon"
        android:padding="8.0dip"
        android:layout_width="45.0dip"
        android:layout_height="45.0dip"
        android:src="@drawable/kr_script"
        android:maxWidth="45.0dip"
        android:maxHeight="45.0dip"
        android:minWidth="45.0dip"
        android:minHeight="45.0dip"
        app:tint="@color/colorAccent" />
    <LinearLayout
        android:layout_gravity="fill_horizontal|center"
        android:orientation="vertical"
        android:id="@id/center"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:paddingStart="7.0dip">
        <TextView
            android:textSize="14.0dip"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:id="@id/ItemTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:lines="1" />
        <TextView
            android:layout_gravity="fill_horizontal"
            android:id="@id/ItemText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minLines="1"
            style="@style/textXSmall" />
    </LinearLayout>
    <Button
        android:layout_gravity="center_vertical"
        android:id="@id/action_delete"
        android:text="@string/btn_delete"
        android:layout_marginStart="6.0dip"
        style="@style/SceneButtonLight" />
</LinearLayout>