<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center"
        android:id="@id/itemIcon"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:layout_margin="10.0dip"
        android:src="@drawable/process_android" />
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <View
            android:id="@id/itemModeDot"
            android:background="@drawable/powercfg_powersave"
            android:layout_width="6.0dip"
            android:layout_height="10.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginEnd="6.0dip" />
        <TextView
            android:textSize="12.0dip"
            android:textColor="?android:textColorPrimary"
            android:gravity="center_vertical"
            android:id="@id/itemTitle"
            android:layout_width="fill_parent"
            android:layout_height="18.0dip"
            android:text="@string/app_name"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/itemModeDot"
            android:layout_alignParentEnd="true"
            android:breakStrategy="simple" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:layout_below="@id/itemTitle">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVG:"
                android:layout_marginEnd="2.0dip"
                style="@style/textSmall" />
            <TextView
                android:id="@id/itemAvgIO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0000mA, 00.0℃"
                style="@style/textSmall" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX:"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginEnd="2.0dip"
                style="@style/textSmall" />
            <TextView
                android:id="@id/itemTemperature"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:minWidth="40.0dip"
                android:text="00.0℃"
                android:layout_weight="1.0"
                android:layout_marginStart="4.0dip"
                style="@style/textSmall" />
            <TextView
                android:id="@id/itemCounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="***"
                android:layout_marginEnd="8.0dip"
                style="@style/textSmall" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>