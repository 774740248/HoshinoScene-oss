<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="10.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/app_logo"
            android:layout_width="50.0dip"
            android:layout_height="50.0dip"
            android:src="@drawable/in_card_item" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="8.0dip">
            <TextView
                android:id="@id/app_options_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="AppName"
                style="@style/textTitle" />
            <TextView
                android:id="@id/app_version_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Version Name: "
                style="@style/textSecondary" />
            <TextView
                android:id="@id/app_version_code"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Version Code: "
                style="@style/textSecondary" />
        </LinearLayout>
    </LinearLayout>
    <com.omarea.ui.CornerView
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/app_options_copay_package"
                android:background="?cardBg"
                android:padding="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="35.0dip"
                    android:layout_weight="1.0">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_package_name"
                        style="@style/textSecondary" />
                    <TextView
                        android:id="@id/app_package_name"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/textSmall" />
                </LinearLayout>
                <ImageView
                    android:padding="5.0dip"
                    android:layout_width="30.0dip"
                    android:layout_height="30.0dip"
                    android:src="@drawable/app_options_copy"
                    android:alpha="0.5"
                    app:tint="@android:color/darker_gray" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/app_options_copay_path"
                android:background="?cardBg"
                android:padding="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip">
                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/apps_install_path"
                    style="@style/textSecondary" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@id/app_install_path"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_weight="1.0"
                        style="@style/textSmall" />
                    <ImageView
                        android:padding="5.0dip"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:src="@drawable/app_options_copy"
                        android:alpha="0.5"
                        app:tint="@android:color/darker_gray" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:minHeight="50.0dip">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:background="?cardBg"
                    android:padding="6.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6.0dip"
                        android:text="TargetSDK"
                        style="@style/textSecondary" />
                    <TextView
                        android:id="@id/app_target_sdk"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/textSmall" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?cardBg"
                    android:padding="6.0dip"
                    android:layout_width="0.0dip"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.0"
                    android:layout_marginStart="2.0dip">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6.0dip"
                        android:text="MinSDK"
                        style="@style/textSecondary" />
                    <TextView
                        android:id="@id/app_min_sdk"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        style="@style/textSmall" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/app_options_share"
                    android:background="?cardBg"
                    android:padding="6.0dip"
                    android:visibility="gone"
                    android:layout_width="50.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="2.0dip">
                    <ImageView
                        android:padding="7.0dip"
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:src="@drawable/icon_share"
                        app:tint="?android:colorAccent" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/app_options_open_detail"
                    android:background="?cardBg"
                    android:padding="6.0dip"
                    android:layout_width="50.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="2.0dip">
                    <ImageView
                        android:padding="7.0dip"
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:src="@drawable/app_options_details"
                        app:tint="?android:colorAccent" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/app_options_app_store"
                    android:background="?cardBg"
                    android:padding="6.0dip"
                    android:layout_width="50.0dip"
                    android:layout_height="fill_parent"
                    android:layout_marginStart="2.0dip">
                    <ImageView
                        android:padding="8.0dip"
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:src="@drawable/app_options_appstore"
                        app:tint="?android:colorAccent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.omarea.ui.CornerView>
</LinearLayout>