<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/activity_vertical_margin"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@id/ItemTop"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/ItemTitle"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4.0dip"
            style="@style/textTitle" />
        <RelativeLayout
            android:background="@drawable/in_card_item_inactive"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12.0dip">
            <TextView
                android:textSize="15.0dip"
                android:textColor="?android:textColorPrimary"
                android:ellipsize="marquee"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@id/ItemApps"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:hint="@string/kr_please_choose_app"
                android:singleLine="true"
                android:layout_weight="1.0"
                android:marqueeRepeatLimit="marquee_forever"
                android:layout_marginEnd="26.0dip"
                android:breakStrategy="simple" />
            <ImageButton
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/kr_app"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginStart="4.0dip"
                android:layout_alignParentEnd="true"
                app:tint="@android:color/darker_gray" />
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:id="@id/ItemDesc"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_below="@id/ItemTop"
        android:textIsSelectable="true"
        style="@style/textSmall" />
</RelativeLayout>