<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:padding="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/confirm_dialog_bg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip"
        android:minHeight="150.0dip"
        android:alpha="0.8">
        <TextView
            android:id="@id/confirm_title"
            android:text="@string/electricity_unit_adj"
            style="@style/dialogTitle" />
        <CheckBox
            android:id="@id/electricity_double"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:text="@string/electricity_double"
            android:layout_marginStart="13.0dip" />
        <TextView
            android:id="@id/confirm_message"
            android:paddingTop="8.0dip"
            android:paddingBottom="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/electricity_unit_adj_desc"
            android:textAlignment="center"
            android:paddingStart="16.0dip"
            android:paddingEnd="16.0dip" />
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@id/electricity_adj_minus"
                android:background="?android:actionBarItemBackground"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/kr_minus"
                android:scaleType="centerInside"
                android:tint="?android:colorAccent" />
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@id/electricity_adj_unit"
                android:layout_width="100.0dip"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                style="@style/textTitle" />
            <ImageButton
                android:id="@id/electricity_adj_plus"
                android:background="?android:actionBarItemBackground"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/kr_plus"
                android:scaleType="centerInside"
                android:tint="?android:colorAccent" />
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/electricity_unit_as" />
            <TextView
                android:textStyle="bold"
                android:id="@id/electricity_adj_sample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0mA"
                android:textAlignment="center" />
        </LinearLayout>
        <TextView
            android:textSize="12.0dip"
            android:textColor="@android:color/holo_red_dark"
            android:paddingTop="12.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:text="@string/electricity_unit_adj_desc2"
            android:textAlignment="center"
            android:layout_marginHorizontal="6.0dip" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip">
        <Button
            android:id="@id/btn_confirm"
            android:text="@string/btn_save"
            android:layout_marginStart="0.0dip"
            style="@style/dialogConfirmBtn" />
    </LinearLayout>
</LinearLayout>