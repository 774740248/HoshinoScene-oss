<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8.0dip"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingRight="8.0dip"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:alpha="0.85">
        <TextView
            android:id="@id/confirm_title"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/dex2oat_mode_select"
            android:paddingStart="@dimen/activity_horizontal_margin"
            style="@style/textTitle" />
        <TextView
            android:id="@id/confirm_message"
            android:paddingTop="8.0dip"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/activity_horizontal_margin" />
        <com.omarea.ui.OptionItemView
            android:id="@id/mode_speed_profile"
            app:desc="@string/dex2oat_mode_profile"
            app:iconColor="@color/color_balance"
            app:iconSrc="@drawable/mode_balance"
            app:title="speed-profile"
            style="@style/ListCardItemSmall" />
        <com.omarea.ui.OptionItemView
            android:id="@id/mode_speed"
            app:desc="@string/dex2oat_mode_speed"
            app:iconColor="@color/color_performance"
            app:iconSrc="@drawable/app_options_data"
            app:title="speed"
            style="@style/ListCardItemSmall" />
        <com.omarea.ui.OptionItemView
            android:id="@id/mode_everything"
            app:desc="@string/dex2oat_mode_everything"
            app:iconColor="@color/color_fast"
            app:iconSrc="@drawable/app_options_data"
            app:title="everything"
            style="@style/ListCardItemSmall" />
        <com.omarea.ui.OptionItemView
            android:id="@id/mode_reset"
            app:desc="@string/dex2oat_mode_reset"
            app:iconPadding="10.0dip"
            app:iconSrc="@drawable/mode_empty"
            app:title="reset"
            style="@style/ListCardItemSmall" />
        <com.omarea.ui.OptionItemView
            android:id="@id/mode_compact"
            app:desc="@string/dex2oat_mode_compact"
            app:iconColor="@color/color_pedestal"
            app:iconPadding="10.0dip"
            app:iconSrc="@drawable/icon_danger"
            app:title="compact"
            style="@style/ListCardItemSmall" />
        <Button
            android:id="@id/faq"
            android:layout_width="120.0dip"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:text="@string/dex2oat_principle"
            android:layout_marginStart="8.0dip"
            style="@style/SceneButton" />
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>