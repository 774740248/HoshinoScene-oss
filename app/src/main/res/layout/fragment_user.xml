<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.omarea.ui.BlurViewRelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="230.0dip"
            android:layout_marginTop="12.0dip"
            style="@style/ListCardItem">
            <TextView
                android:id="@id/user_devices"
                android:layout_marginTop="5.0dip"
                android:text="@string/user_devices"
                android:layout_alignParentEnd="true"
                style="@style/textLink" />
            <TextView
                android:id="@id/user_upgrade"
                android:layout_marginTop="5.0dip"
                android:text="@string/user_upgrade"
                android:layout_below="@id/user_devices"
                android:layout_alignParentEnd="true"
                style="@style/textLink" />
            <ImageView
                android:id="@id/user_avatar"
                android:layout_width="50.0dip"
                android:layout_height="50.0dip"
                android:src="@drawable/icon_avatar"
                android:scaleType="fitCenter"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true" />
            <TextView
                android:id="@id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="@string/user_unregistered"
                android:layout_below="@id/user_avatar"
                android:layout_alignLeft="@id/user_avatar"
                android:layout_centerHorizontal="true"
                android:textIsSelectable="true"
                android:textAllCaps="true"
                android:layout_marginEnd="4.0dip"
                style="@style/textTitle" />
            <TextView
                android:id="@id/user_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                android:text="SN:"
                android:layout_below="@id/user_name"
                android:layout_centerHorizontal="true"
                android:textIsSelectable="true"
                android:layout_alignStart="@id/user_name"
                style="@style/textSmall" />
            <TextView
                android:id="@id/user_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                android:text="@string/user_points_unknown"
                android:layout_below="@id/user_sn"
                android:layout_centerHorizontal="true"
                android:textIsSelectable="true"
                android:layout_alignStart="@id/user_name"
                style="@style/textSmall" />
            <TextView
                android:id="@id/user_key_code"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEY:SJS***JISY"
                android:layout_below="@id/user_points"
                android:layout_centerHorizontal="true"
                android:textIsSelectable="true"
                android:layout_alignStart="@id/user_name"
                style="@style/textSmall" />
            <ImageView
                android:id="@id/user_logo"
                android:layout_width="35.0dip"
                android:layout_height="35.0dip"
                android:layout_marginTop="126.0dip"
                android:src="@drawable/icon_vip"
                android:scaleType="fitCenter"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true" />
            <TextView
                android:id="@id/user_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="@string/license_trial"
                android:layout_below="@id/user_logo"
                android:layout_alignRight="@id/user_logo"
                android:layout_centerHorizontal="true"
                android:layout_marginEnd="2.0dip"
                style="@style/textSmall" />
            <TextView
                android:id="@id/user_expire_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/license_expiry_unknown"
                android:layout_below="@id/user_version"
                android:layout_centerHorizontal="true"
                android:layout_alignEnd="@id/user_version"
                style="@style/textSmall" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/user_contact"
                android:background="@drawable/list_item_ripple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <ImageView
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip"
                    android:layout_margin="1.0dip"
                    android:src="@drawable/icon_outlook" />
                <TextView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_seek_help"
                    android:layout_marginStart="7.0dip"
                    style="@style/textSmall" />
            </LinearLayout>
        </com.omarea.ui.BlurViewRelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
            <com.omarea.ui.BlurView
                android:background="@drawable/krscript_item_ripple_inactive"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0">
                <TextView
                    android:textSize="14.0dip"
                    android:textColor="@color/colorAccent"
                    android:id="@id/user_change_sn"
                    android:padding="@dimen/activity_vertical_margin"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_use_code"
                    android:textAlignment="center"
                    android:layout_marginEnd="4.0dip" />
            </com.omarea.ui.BlurView>
            <com.omarea.ui.BlurView
                android:background="@drawable/krscript_item_ripple_inactive"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="4.0dip">
                <TextView
                    android:textSize="14.0dip"
                    android:textColor="@color/colorAccent"
                    android:id="@id/user_go_pay"
                    android:padding="@dimen/activity_vertical_margin"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_use_purchase"
                    android:textAlignment="center" />
            </com.omarea.ui.BlurView>
        </LinearLayout>
        <com.omarea.ui.BlurView
            android:background="@drawable/krscript_item_ripple_inactive"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:paddingHorizontal="@dimen/activity_horizontal_margin"
            android:paddingVertical="@dimen/activity_horizontal_margin">
            <TextView
                android:textSize="12.0dip"
                android:id="@id/user_message"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:fontFamily="monospace" />
        </com.omarea.ui.BlurView>
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/nav"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:layout_marginStart="25.0dip"
            android:layout_marginEnd="25.0dip">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/user_talking_share"
                style="@style/textSmall" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/nav_share"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/share_logo" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_share"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        style="@style/textDefault" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/nav_qq"
                    android:visibility="gone"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="38.0dip"
                        android:layout_height="38.0dip"
                        android:layout_margin="1.0dip"
                        android:src="@drawable/qq_logo" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_qq"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/nav_insider_preview"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="38.0dip"
                        android:layout_height="38.0dip"
                        android:layout_margin="1.0dip"
                        android:src="@drawable/qq_logo" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_qq_preview"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        style="@style/textDefault" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25.0dip"
                android:text="@string/user_recommended"
                style="@style/textSmall" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/nav_gesture"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/gesture_logo" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_gesture"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        style="@style/textDefault" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@id/nav_filter"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:layout_weight="1.0">
                    <ImageView
                        android:layout_width="38.0dip"
                        android:layout_height="38.0dip"
                        android:layout_margin="1.0dip"
                        android:src="@drawable/filter_logo" />
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_filter"
                        android:layout_weight="1.0"
                        android:layout_marginStart="10.0dip"
                        style="@style/textDefault" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>