<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/layout_app_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_app_bar" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?actionBarSize">
        <include
            android:id="@id/nav_scene_service_not_active"
            layout="@layout/layout_accessibility_state" />
        <com.omarea.ui.BlurViewLinearLayout
            style="@style/ListCardItem">
            <Switch
                android:id="@id/settings_auto_install"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/scene_install_autoclick" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/scene_install_autoclick_desc"
                style="@style/textSmall" />
            <Switch
                android:id="@id/settings_auto_allow"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/scene_allow_autoclick" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/scene_allow_autoclick_desc"
                style="@style/textSmall" />
        </com.omarea.ui.BlurViewLinearLayout>
        <com.omarea.ui.BlurViewLinearLayout
            style="@style/ListCardItem">
            <Switch
                android:id="@id/settings_quickly_grant"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/scene_quickly_grant" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/scene_quickly_grant_desc"
                style="@style/textSmall" />
        </com.omarea.ui.BlurViewLinearLayout>
        <com.omarea.ui.BlurViewLinearLayout
            android:id="@id/settings_skip_ad_panel"
            style="@style/ListCardItem">
            <Switch
                android:id="@id/settings_skip_ad"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/scene_skip_ad" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:text="@string/scene_skip_ad_desc"
                style="@style/textSmall" />
            <LinearLayout
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <Switch
                    android:id="@id/settings_skip_ad_precise"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin"
                    android:text="@string/scene_skip_ad_precise" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:text="@string/scene_skip_ad_precise_desc"
                    style="@style/textSmall" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/ad_skip_blacklist"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_marginHorizontal="0.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0">
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scene_skip_ad_blacklist"
                        style="@style/textTitle" />
                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="@string/scene_skip_ad_blacklist_desc"
                        style="@style/textSmall" />
                </LinearLayout>
                <ImageView
                    android:padding="10.0dip"
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:src="@drawable/kr_picker"
                    android:alpha="0.8"
                    app:tint="?android:colorAccent" />
            </LinearLayout>
            <TextView
                android:textColor="?android:colorAccent"
                android:background="@drawable/in_card_item_inactive"
                android:padding="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:text="@string/scene_skip_ad_warn"
                android:lineHeight="20.0dip"
                style="@style/textSmall" />
        </com.omarea.ui.BlurViewLinearLayout>
    </LinearLayout>
</RelativeLayout>