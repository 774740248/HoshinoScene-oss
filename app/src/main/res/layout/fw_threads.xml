<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_gravity="top"
    android:orientation="vertical"
    android:background="@drawable/shape_corner"
    android:paddingBottom="6.0dip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/fw_back"
            android:padding="3.0dip"
            android:visibility="gone"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/fw_back" />
        <TextView
            android:textSize="7.0dip"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:id="@id/fw_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="Threads"
            android:maxLines="2"
            android:layout_weight="1.0"
            android:fontFamily="monospace"
            android:paddingStart="8.0dip"
            style="@style/textSmallTitle" />
        <ImageView
            android:layout_gravity="end"
            android:id="@id/close"
            android:padding="7.0dip"
            android:layout_width="24.0dip"
            android:layout_height="24.0dip"
            android:src="@drawable/close_white" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="150.0dip"
        android:layout_height="120.0dip"
        android:paddingStart="8.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/fw_thread_list"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="6.0dip"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="start|center"
                    android:id="@id/thread_load"
                    android:layout_width="22.0dip"
                    android:layout_height="wrap_content"
                    android:text="CPU%" />
                <TextView
                    android:textSize="6.0dip"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="start|center"
                    android:id="@id/item_cpus"
                    android:layout_width="28.0dip"
                    android:layout_height="wrap_content"
                    android:text="CPUS" />
                <TextView
                    android:textSize="6.0dip"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="start|center"
                    android:id="@id/thread_pid"
                    android:layout_width="25.0dip"
                    android:layout_height="wrap_content"
                    android:text="TID" />
                <TextView
                    android:textSize="6.0dip"
                    android:textStyle="bold"
                    android:textColor="#ffffffff"
                    android:gravity="start|center"
                    android:id="@id/item_comm"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="COMM"
                    android:layout_weight="1.0" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@id/fw_threads"
                android:background="@null"
                android:layout_width="fill_parent"
                android:layout_height="0.0dip"
                android:layout_weight="1.0"
                android:overScrollMode="never" />
        </LinearLayout>
        <FrameLayout
            android:id="@id/fw_thread_detail"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="7.0dip"
                android:textColor="#ffffffff"
                android:id="@id/fw_thread_detail_info"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:fontFamily="monospace"
                android:lineHeight="12.0dip" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>