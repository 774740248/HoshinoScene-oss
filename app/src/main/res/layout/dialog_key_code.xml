<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:id="@id/confirm_title"
        android:text="@string/user_code_dialog_title"
        style="@style/dialogTitle" />
    <TextView
        android:id="@id/confirm_message"
        android:text="@string/user_code_dialog_desc"
        android:paddingStart="@dimen/activity_horizontal_margin"
        style="@style/dialogDesc" />
    <LinearLayout
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        style="@style/dialogWarn">
        <EditText
            android:textSize="13.0dip"
            android:id="@id/dialog_text"
            android:background="@null"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_code_input"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="36"
            android:imeOptions="actionDone"
            android:breakStrategy="simple"
            android:paddingHorizontal="5.0dip" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@id/account"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:textIsSelectable="true"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            style="@style/textSmall" />
        <TextView
            android:textColor="@color/colorAccent"
            android:id="@id/login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_other_account"
            style="@style/textDefault" />
        <TextView
            android:textColor="@color/colorAccent"
            android:id="@id/payment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_code_purchase"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            style="@style/textDefault" />
    </LinearLayout>
</LinearLayout>