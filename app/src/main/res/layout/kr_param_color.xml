<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <EditText
        android:textSize="15.0dip"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@id/kr_param_color_text"
        android:background="@android:color/transparent"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:minHeight="35.0dip"
        android:hint="@string/kr_please_input_color"
        android:maxLength="9"
        android:layout_weight="1.0"
        android:marqueeRepeatLimit="marquee_forever" />
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/kr_param_color_invalid"
        android:padding="2.0dip"
        android:layout_width="22.0dip"
        android:layout_height="22.0dip"
        android:src="@drawable/kr_warn" />
    <View
        android:layout_gravity="center_vertical"
        android:id="@id/kr_param_color_preview"
        android:padding="2.0dip"
        android:layout_width="22.0dip"
        android:layout_height="22.0dip" />
    <ImageButton
        android:layout_gravity="center_vertical"
        android:id="@id/kr_param_color_picker"
        android:background="@android:color/transparent"
        android:padding="5.0dip"
        android:layout_width="30.0dip"
        android:layout_height="30.0dip"
        android:layout_marginLeft="4.0dip"
        android:src="@drawable/kr_color"
        android:scaleType="centerInside"
        android:tint="@android:color/darker_gray" />
</LinearLayout>