<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@id/drawer_layout"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        layout="@layout/layout_app_bar" />
    <com.omarea.ui.BlurViewLinearLayout
        android:orientation="horizontal"
        android:id="@id/tip"
        android:background="@drawable/list_view_bg"
        android:padding="@dimen/activity_horizontal_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?android:actionBarSize"
        android:layout_marginBottom="8.0dip"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <TextView
            android:textColor="@color/colorAccent"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/apps_retrieve_tip"
            android:layout_weight="1.0"
            android:breakStrategy="simple"
            style="@style/textSmall" />
        <ImageView
            android:id="@id/apps_force_reset"
            android:background="?android:actionBarItemBackground"
            android:padding="6.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:src="@drawable/delete"
            app:tint="@android:color/holo_red_dark" />
    </com.omarea.ui.BlurViewLinearLayout>
    <com.omarea.ui.BlurView
        android:background="@drawable/list_view_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_below="@id/tip"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <com.omarea.common.ui.OverScrollListView
            android:id="@id/hidden_app"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:divider="@null" />
    </com.omarea.ui.BlurView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@id/fab_confirm"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40.0dip"
        android:src="@drawable/check"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="35.0dip"
        android:layout_alignParentEnd="true" />
</RelativeLayout>