<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:theme="@style/AppThemeLight"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:background="@drawable/krscript_item_ripple_inactive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6.0dip"
        app:cardCornerRadius="8.0dip">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/popup_window"
            android:layout_width="290.0dip"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="35.0dip"
                android:paddingStart="10.0dip"
                android:paddingEnd="6.0dip">
                <TextView
                    android:id="@id/fw_title"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:lines="1"
                    android:layout_weight="1.0"
                    style="@style/textTitle" />
                <ImageButton
                    android:layout_gravity="center_vertical"
                    android:id="@id/fw_float_close"
                    android:background="@android:color/transparent"
                    android:padding="6.0dip"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:src="@drawable/close_black"
                    android:scaleType="fitCenter"
                    android:alpha="0.8" />
            </LinearLayout>
            <View
                android:background="#ffe0e0e0"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginBottom="5.0dip" />
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/activity_vertical_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/fw_float_monitor"
                    android:background="@drawable/dialog_icon_bg"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@drawable/fw_float_monitor"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#fffb8c00"
                    app:tint="#ffffffff" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/fw_float_task"
                    android:background="@drawable/dialog_icon_bg"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@drawable/ic_processes"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#ff7cb342"
                    app:tint="#ffffffff" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/fw_float_threads"
                    android:background="@drawable/dialog_icon_bg"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@drawable/icon_threads"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#ff41b0b5"
                    app:tint="#ffffffff" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/fw_float_monitor_mini"
                    android:background="@drawable/dialog_icon_bg"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@drawable/fw_float_monitor_mini"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#c0605b6c"
                    app:tint="#ffffffff" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/fw_float_fps"
                    android:background="@drawable/dialog_icon_bg"
                    android:layout_width="35.0dip"
                    android:layout_height="35.0dip"
                    android:src="@drawable/fw_float_fps"
                    android:layout_marginStart="10.0dip"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#ffffb700"
                    app:tint="#ffffffff" />
            </LinearLayout>
            <View
                android:background="#ffe0e0e0"
                android:layout_width="fill_parent"
                android:layout_height="1.0dip"
                android:layout_marginTop="5.0dip" />
            <LinearLayout
                android:gravity="start"
                android:orientation="horizontal"
                android:paddingBottom="5.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5.0dip"
                android:paddingStart="7.0dip"
                android:paddingEnd="10.0dip">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@id/fw_scene_version"
                    android:layout_width="wrap_content"
                    android:layout_height="25.0dip"
                    android:text="SCENE"
                    style="@style/textXSmall" />
                <View
                    android:layout_width="0.0dip"
                    android:layout_height="0.0dip"
                    android:layout_weight="1.0" />
                <Switch
                    android:textSize="12.0dip"
                    android:textColor="#ff888888"
                    android:layout_gravity="center_vertical"
                    android:id="@id/fw_perf_boost"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monster+"
                    android:switchPadding="4.0dip"
                    android:layout_marginStart="8.0dip" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>