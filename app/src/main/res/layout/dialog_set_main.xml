<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@id/confirm_title"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/user_upgrade"
        android:paddingStart="@dimen/activity_horizontal_margin"
        style="@style/textTitle" />
    <TextView
        android:textSize="12.0dip"
        android:id="@id/confirm_message"
        android:paddingTop="8.0dip"
        android:paddingRight="10.0dip"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="@string/user_upgrade_desc"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:breakStrategy="simple" />
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/in_card_item"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginStart="@dimen/activity_horizontal_margin"
        android:layout_marginEnd="@dimen/activity_horizontal_margin">
        <com.omarea.ui.SwitchOptionItemView
            android:enabled="false"
            android:id="@id/agreement"
            android:padding="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="70.0dip"
            app:desc="@string/user_upgrade_confirm"
            app:iconColor="@color/colorPrimary"
            app:iconSrc="@drawable/icon_android"
            app:title="@string/scene_contract_agree" />
        <com.omarea.ui.SwitchOptionItemView
            android:id="@id/force"
            android:padding="6.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="70.0dip"
            app:desc="@string/user_upgrade_force_desc"
            app:iconColor="@color/colorPrimary"
            app:iconSrc="@drawable/icon_android"
            app:title="@string/user_upgrade_force" />
    </LinearLayout>
</LinearLayout>