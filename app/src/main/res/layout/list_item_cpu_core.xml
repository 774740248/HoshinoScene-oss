<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:paddingLeft="4.0dip"
    android:paddingTop="4.0dip"
    android:paddingRight="4.0dip"
    android:layout_width="fill_parent"
    android:layout_height="85.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="49.0dip"
            android:layout_height="45.0dip">
            <com.omarea.ui.CpuChartBarView
                android:id="@id/core_cpu_loading_chart"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                app:free="1"
                app:total="1" />
            <TextView
                android:textSize="12.0dip"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:id="@id/cpu_core_load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%" />
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@id/center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.0dip"
            android:layout_marginBottom="2.0dip"
            android:layout_weight="1.0">
            <TextView
                android:textSize="12.0dip"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:id="@id/cpu_core_current_freq"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="----Mhz"
                android:lines="1"
                android:textAlignment="center" />
            <TextView
                android:textSize="8.5dip"
                android:textColor="?android:textColorTertiary"
                android:id="@id/cpu_core_freq_ranage"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="---Mhz ~ ----Mhz"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>