<?xml version="1.0" encoding="utf-8"?>
<com.omarea.common.ui.OverScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/krscript_item_ripple_inactive"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip">
            <TextView
                android:id="@id/confirm_title"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/freezer_settings"
                android:paddingStart="@dimen/activity_horizontal_margin"
                style="@style/textTitle" />
            <TextView
                android:id="@id/confirm_message"
                android:paddingTop="8.0dip"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/freezer_settings_desc"
                android:paddingStart="@dimen/activity_horizontal_margin" />
            <TableLayout
                android:background="@drawable/in_card_item_inactive"
                android:padding="@dimen/activity_horizontal_margin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_vertical_margin"
                android:stretchColumns="0"
                android:showDividers="beginning"
                android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@id/freeze_suspend"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.omarea.ui.HelpIcon
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="@string/freezer_keep_icon_desc" />
                    <Switch
                        android:id="@id/freeze_suspend_mode"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/freezer_keep_icon"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin">
                    <com.omarea.ui.HelpIcon
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="@string/freezer_timeout_desc" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/freezer_timeout"
                        android:layout_weight="1.0"
                        style="@style/textTitle" />
                </LinearLayout>
                <com.omarea.common.ui.SeekBar
                    android:id="@id/freeze_time_limit"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6.0dip"
                    app:max="10"
                    app:min="0"
                    app:progress="2"
                    style="@style/SceneSeekBar" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin">
                    <com.omarea.ui.HelpIcon
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="@string/freezer_shortcut_suggest_desc" />
                    <Switch
                        android:id="@id/freeze_shortcut_suggest"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/freezer_shortcut_suggest"
                        android:layout_weight="1.0" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_vertical_margin">
                    <com.omarea.ui.HelpIcon
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="@string/freezer_icon_desc" />
                    <Switch
                        android:id="@id/freeze_quick_entry"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/freezer_icon"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </TableLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin">
            <Button
                android:id="@id/btn_cancel"
                android:text="@string/btn_cancel"
                android:layout_marginEnd="8.0dip"
                style="@style/dialogCancelBtn" />
            <Button
                android:id="@id/btn_confirm"
                android:text="@string/btn_confirm"
                style="@style/dialogConfirmBtn" />
        </LinearLayout>
    </LinearLayout>
</com.omarea.common.ui.OverScrollView>