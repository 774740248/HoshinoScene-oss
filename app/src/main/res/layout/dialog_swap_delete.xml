<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:padding="12.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/krscript_item_ripple_inactive"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.0dip">
        <TextView
            android:id="@id/confirm_title"
            android:text="@string/swap_off"
            style="@style/dialogTitle" />
        <TextView
            android:id="@id/confirm_message"
            android:visibility="gone"
            style="@style/dialogDesc" />
        <TextView
            android:background="@drawable/in_card_item"
            android:padding="@dimen/activity_vertical_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:text="@string/swap_off_slow_warn"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            style="@style/textSmall" />
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/in_card_item"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/activity_horizontal_margin">
            <com.omarea.ui.SwitchOptionItemView
                android:id="@id/swap_delete_file"
                android:padding="6.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="70.0dip"
                app:desc="@string/swap_off_delete_desc"
                app:iconColor="#ffff9800"
                app:iconSrc="@drawable/swap_delete"
                app:title="@string/swap_off_delete" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_vertical_margin">
        <Button
            android:id="@id/btn_cancel"
            android:text="@string/btn_cancel"
            style="@style/dialogCancelBtn" />
        <Button
            android:id="@id/btn_confirm"
            android:text="@string/btn_confirm"
            android:layout_marginStart="8.0dip"
            style="@style/dialogConfirmBtn" />
    </LinearLayout>
</LinearLayout>