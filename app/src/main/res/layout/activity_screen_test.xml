<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <View
        android:background="?cardBg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="260.0dip"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="20.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="DisplayInfo"
            android:fontFamily="sans-serif-condensed-light" />
        <TextView
            android:textSize="12.0dip"
            android:id="@id/display_info"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="20.0dip"
            android:fontFamily="monospace" />
        <Button
            android:id="@id/display_go"
            android:background="@drawable/btn_bg_large_secondary"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="0.0dip"
            android:text="Start Test"
            style="@style/dialogLargeBtn" />
    </LinearLayout>
    <com.omarea.ui.ScreenTest
        android:id="@id/display_test"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</RelativeLayout>