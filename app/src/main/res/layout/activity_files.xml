<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <include
        android:id="@id/layout_app_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_app_bar" />
    <com.omarea.ui.files.BreadcrumbView
        android:id="@id/breadcrumb_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9.0dip"
        android:layout_below="@id/layout_app_bar"
        android:layout_marginHorizontal="12.0dip" />
    <LinearLayout
        android:gravity="end|center"
        android:orientation="horizontal"
        android:id="@id/titlebar_buttons"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/layout_app_bar"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_marginStart="55.0dip"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <com.omarea.ui.SearchInput
            android:id="@id/search_bar"
            android:layout_width="40.0dip"
            android:layout_height="40.0dip" />
        <ImageView
            android:id="@id/btn_sort"
            android:paddingTop="12.0dip"
            android:paddingBottom="10.0dip"
            android:src="@drawable/icon_sort_des"
            android:paddingHorizontal="11.0dip"
            style="@style/SceneTitleBarBtn" />
        <ImageView
            android:id="@id/btn_favorite"
            android:padding="9.0dip"
            android:src="@drawable/ic_star"
            style="@style/SceneTitleBarBtn" />
        <ImageView
            android:id="@id/btn_more"
            android:padding="7.0dip"
            android:src="@drawable/icon_add"
            android:layout_marginEnd="8.0dip"
            style="@style/SceneTitleBarBtn" />
    </LinearLayout>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@id/titlebar_buttons2"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginBottom="9.0dip"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_marginStart="55.0dip"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@id/btn_copy"
            android:padding="10.0dip"
            android:src="@drawable/copy"
            style="@style/SceneTitleBarBtn" />
        <ImageView
            android:id="@id/btn_move"
            android:padding="10.0dip"
            android:src="@drawable/file_options_move"
            style="@style/SceneTitleBarBtn" />
        <ImageView
            android:id="@id/btn_delete"
            android:padding="11.0dip"
            android:src="@drawable/delete"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            style="@style/SceneTitleBarBtn" />
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/top_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_app_bar">
        <com.omarea.ui.BlurViewLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/file_paste_summary"
            android:background="@drawable/krscript_item_ripple_inactive"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6.0dip"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin"
            android:paddingHorizontal="@dimen/activity_horizontal_margin"
            android:paddingVertical="8.0dip">
            <ImageView
                android:id="@id/file_paste_preview"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/file" />
            <TextView
                android:id="@id/file_paste_path"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:layout_marginStart="8.0dip"
                style="@style/textSmall" />
            <Button
                android:id="@id/btn_paste"
                android:layout_width="60.0dip"
                android:text="@string/fs_paste"
                android:layout_marginStart="10.0dip"
                style="@style/SceneButton" />
        </com.omarea.ui.BlurViewLinearLayout>
    </LinearLayout>
    <com.omarea.ui.BlurView
        android:id="@id/file_list_container"
        android:background="@drawable/list_view_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@id/bottom_bar"
        android:layout_below="@id/top_bar"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/list_files"
            android:background="@null"
            android:visibility="visible"
            android:scrollbars="none"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:overScrollMode="never" />
    </com.omarea.ui.BlurView>
    <FrameLayout
        android:id="@id/bottom_bar"
        android:paddingBottom="14.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
        <com.omarea.ui.TabBarView
            android:id="@id/tab_bar"
            android:layout_width="fill_parent"
            android:layout_height="44.0dip" />
    </FrameLayout>
</RelativeLayout>