<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:saveEnabled="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:id="@id/layout_app_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_app_bar" />
    <ImageView
        android:id="@id/share_desktop"
        android:padding="10.0dip"
        android:layout_marginBottom="9.0dip"
        android:src="@drawable/icon_windows"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_toStartOf="@id/share_key_config"
        style="@style/SceneTitleBarBtn" />
    <ImageView
        android:id="@id/share_key_config"
        android:padding="8.0dip"
        android:layout_marginBottom="9.0dip"
        android:src="@drawable/icon_key"
        android:layout_alignBottom="@id/layout_app_bar"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:layout_alignParentEnd="true"
        style="@style/SceneTitleBarBtn" />
    <com.omarea.ui.CornerView
        android:id="@id/warn"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_app_bar"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin" />
    <LinearLayout
        android:orientation="vertical"
        android:id="@id/top_bar"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/warn">
        <com.omarea.ui.BlurViewLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/share_actions"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            style="@style/ListCardItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fs_send" />
            <ImageView
                android:id="@id/share_settings"
                android:padding="0.0dip"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/settings"
                android:scaleType="centerInside"
                android:layout_marginStart="8.0dip"
                app:tint="@color/colorAccent"
                style="@style/SceneButtonLight" />
            <TextView
                android:id="@id/share_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="8.0dip"
                style="@style/textXSmall" />
            <ImageView
                android:id="@id/share_app"
                android:background="?actionBarItemBackground"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/process_android" />
            <ImageView
                android:id="@id/share_game"
                android:background="?actionBarItemBackground"
                android:padding="9.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/icon_game" />
            <ImageView
                android:id="@id/share_folder"
                android:background="?actionBarItemBackground"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/folder" />
        </com.omarea.ui.BlurViewLinearLayout>
        <com.omarea.ui.UMExpandLayout
            android:id="@id/share_settings_expand"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/in_card_item"
                android:padding="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="Band"
                        android:layout_weight="1.0"
                        android:paddingStart="12.0dip"
                        style="@style/textSmall" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="BandWidth"
                        android:layout_weight="1.0"
                        android:paddingStart="12.0dip"
                        style="@style/textSmall" />
                    <TextView
                        android:visibility="gone"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="WPA3"
                        android:layout_weight="1.0"
                        android:paddingStart="12.0dip"
                        style="@style/textSmall" />
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/fs_mode"
                        android:layout_weight="1.0"
                        android:paddingStart="12.0dip"
                        style="@style/textSmall" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.omarea.ui.SelectView
                        android:id="@id/share_band"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <com.omarea.ui.SelectView
                        android:enabled="false"
                        android:id="@id/share_bandwidth"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <Switch
                        android:layout_gravity="center"
                        android:id="@id/share_wpa3"
                        android:visibility="gone"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                    <com.omarea.ui.SelectView
                        android:id="@id/share_transport"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
        </com.omarea.ui.UMExpandLayout>
        <com.omarea.ui.BlurViewLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/pull_actions"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            style="@style/ListCardItem">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fs_receive" />
            <ImageView
                android:id="@id/pull_settings"
                android:padding="0.0dip"
                android:layout_width="20.0dip"
                android:layout_height="20.0dip"
                android:src="@drawable/settings"
                android:scaleType="centerInside"
                android:layout_marginStart="8.0dip"
                app:tint="@color/colorAccent"
                style="@style/SceneButtonLight" />
            <TextView
                android:id="@id/pull_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="8.0dip"
                style="@style/textXSmall" />
            <ImageView
                android:id="@id/share_pull"
                android:background="?actionBarItemBackground"
                android:padding="10.0dip"
                android:layout_width="40.0dip"
                android:layout_height="40.0dip"
                android:src="@drawable/ic_menu_download"
                app:tint="?android:colorAccent" />
        </com.omarea.ui.BlurViewLinearLayout>
        <com.omarea.ui.UMExpandLayout
            android:id="@id/pull_settings_expand"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/activity_horizontal_margin">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/in_card_item"
                android:padding="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/fs_mode"
                        android:layout_weight="1.0"
                        android:paddingStart="12.0dip"
                        style="@style/textSmall" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.omarea.ui.SelectView
                        android:id="@id/pull_transport"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0" />
                </LinearLayout>
            </LinearLayout>
        </com.omarea.ui.UMExpandLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:layout_alignParentBottom="true">
        <com.omarea.ui.BlurViewLinearLayout
            android:orientation="vertical"
            android:id="@id/share_status_card"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:keepScreenOn="true"
            style="@style/ListCardItem">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="10.0dip"
                    android:textColor="@android:color/white"
                    android:id="@id/share_status_type"
                    android:background="@drawable/powercfg_balance"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="today"
                    android:layout_marginEnd="4.0dip"
                    android:paddingHorizontal="5.0dip"
                    android:paddingVertical="1.5999756dip" />
                <TextView
                    android:textSize="16.0dip"
                    android:textColor="?android:textColorPrimary"
                    android:id="@id/share_status_phase"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
                <TextView
                    android:textColor="?android:colorAccent"
                    android:id="@id/share_status_stop"
                    android:background="?actionBarItemBackground"
                    android:padding="8.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fs_stop" />
            </LinearLayout>
            <TextView
                android:id="@id/share_status_summary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                style="@style/textSmall" />
            <ProgressBar
                android:id="@id/share_status_progress"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:max="1000"
                style="?android:progressBarStyleHorizontal" />
            <TextView
                android:id="@id/share_status_detail"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                style="@style/textSmall" />
            <TextView
                android:id="@id/share_status_error"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                style="@style/textSmall" />
        </com.omarea.ui.BlurViewLinearLayout>
        <TextView
            android:id="@id/share_trans_help"
            android:padding="@dimen/activity_horizontal_margin"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_trans_help"
            android:lineHeight="16.0dip"
            style="@style/textSmall" />
    </LinearLayout>
</RelativeLayout>